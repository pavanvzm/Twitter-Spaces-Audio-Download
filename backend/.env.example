# X Spaces Downloader - Backend Environment Configuration

# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
LOG_FORMAT=json

# X OAuth Configuration
# Register your app at: https://developer.twitter.com/apps
X_CLIENT_ID=your_x_client_id_here
X_CLIENT_SECRET=your_x_client_secret_here
X_BEARER_TOKEN=your_bearer_token_here

# OAuth Redirect
# Must match what's configured in your X app settings
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Storage Directories
DOWNLOAD_DIR=/tmp/x-spaces-downloads

# Security
SESSION_SECRET=generate_a_secure_random_string_here

# Rate Limiting (requests per 15 minutes)
RATE_LIMIT_GENERAL=1000
RATE_LIMIT_AUTH=20
RATE_LIMIT_SPACES=200
RATE_LIMIT_DOWNLOAD=10

# Cache TTL (seconds)
CACHE_TTL_SPACES=300
CACHE_TTL_USER=600

# Optional: Redis Configuration (for production)
# REDIS_URL=redis://localhost:6379

# Optional: MongoDB Configuration (for production)
# MONGODB_URI=mongodb://localhost:27017/x-spaces
